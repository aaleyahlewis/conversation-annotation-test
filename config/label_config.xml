<View>
  <!-- CHATGPT_CONVERSATION_IMPORT: tasks come from chatgpt_to_labelstudio.py (paragraphs format, the default),
       which writes the conversation to data.dialogue with message_id, index, role, author, text. -->
  <Style>
    .typ-layout { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 16px; width: 100%; box-sizing: border-box; }
    .typ-convo { flex: 1 1 380px; min-width: 300px; max-width: 100%; box-sizing: border-box; background: #ffffff; color: #0d0d0d; border-radius: 12px; padding: 16px; font-family: ui-sans-serif, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; }
    .typ-side { flex: 1 1 280px; min-width: 260px; max-width: 100%; box-sizing: border-box; padding: 0 8px; overflow-wrap: anywhere; }
    .typ-panel { border-left: 4px solid #2b5797; padding: 8px 12px; margin-bottom: 16px; }
    .typ-ai { border-left: 4px dashed #8a3b12; }
    .typ-conv { border-left: 4px dotted #4a6b2b; margin-top: 24px; }
    .typ-def { font-size: 0.9em; opacity: 0.85; }
    .typ-side textarea { width: 100%; box-sizing: border-box; }
    .typ-layout *:focus-visible { outline: 3px solid #1a73e8; outline-offset: 2px; }

    /* ChatGPT look for Paragraphs layout="dialogue".
       Label Studio colors each speaker from a hash of its name: "You" = #bfb272 (191, 178, 114),
       "ChatGPT" = #72bfbc (114, 191, 188). These selectors rely on the author names set by the converter. */
    .typ-convo [class*="phrase--"] { display: block !important; box-sizing: border-box; margin: 0 0 18px 0 !important; line-height: 1.6; font-size: 15px; border: 0 !important; box-shadow: none !important; }
    .typ-convo [class*="dialoguetext--"] { white-space: pre-wrap; cursor: text; }
    .typ-convo [class*="dialoguename--"] { display: block; width: fit-content; background: transparent !important; padding: 0 0 2px 0 !important; margin: 0 !important; font-size: 12px; font-weight: 600; color: #5d5d5d !important; }
    .typ-convo [class*="dialoguename--"] span { background: transparent !important; }
    /* Hide audio-transcript extras that do not apply to chat logs: empty timestamps, author filter,
       and the whole-message button (participants highlight instead). */
    .typ-convo [class*="time--"],
    .typ-convo [class*="authorFilter--"],
    .typ-convo [class*="wrapper_header--"],
    .typ-convo [class*="selectAllBtnWrapper--"] { display: none !important; }
    .typ-convo [class*="titleWrapper--"] { display: block !important; }

    .typ-convo [class*="phrase--"][style*="191, 178, 114"],
    .typ-convo [class*="phrase--"][style*="#bfb272"] {
      margin-left: auto !important; max-width: 75%; width: fit-content;
      background: #f4f4f4 !important; border-radius: 18px !important; padding: 10px 16px !important;
    }
    .typ-convo [class*="phrase--"][style*="191, 178, 114"] [class*="dialoguename--"],
    .typ-convo [class*="phrase--"][style*="#bfb272"] [class*="dialoguename--"] { margin-left: auto !important; }

    .typ-convo [class*="phrase--"][style*="114, 191, 188"],
    .typ-convo [class*="phrase--"][style*="#72bfbc"] {
      margin-right: auto !important; max-width: 100%; width: 100%;
      background: transparent !important; border-radius: 0 !important; padding: 4px 0 !important;
    }
  </Style>

  <View className="typ-layout">

    <View className="typ-convo">
      <Header value="Your conversation" size="4"/>
      <Text name="how_to" value="To annotate: 1) choose 'my text' (key 1) or 'AI's text' (key 2), 2) highlight the exact text with your mouse. Choose the label again before each new highlight. To annotate a whole message, highlight all of it. Highlights can overlap."/>

      <!-- TYPOLOGY_SPAN_SELECTION: native text-span regions with start/end message index,
           startOffset/endOffset and the highlighted text -->
      <ParagraphLabels name="passage_type" toName="dialogue" showInline="true">
        <Label value="my text" hotkey="1" background="#2b5797"/>
        <Label value="AI's text" hotkey="2" background="#8a3b12"/>
      </ParagraphLabels>

      <Paragraphs name="dialogue" value="$dialogue" layout="dialogue"
                  nameKey="author" textKey="text" saveTextResult="yes"/>
    </View>

    <View className="typ-side">

      <View visibleWhen="no-region-selected" className="typ-panel">
        <Header value="How to annotate" size="4"/>
        <Text name="instr" value="Highlight words in your messages or the AI's responses that you want to comment on. Then click the highlight in the Regions list, then answer any questions you like. For written answers, press Add (or Shift + Enter) to save them. Questions for each highlight are required unless marked optional. You do not need to annotate every message. To edit an annotation, select it in the Regions list. To delete it, select it and press Backspace or use the trash icon."/>
      </View>

      <!-- TYPOLOGY_USER_ANNOTATIONS -->
      <View visibleWhen="region-selected" whenLabelValue="my text" className="typ-panel">
        <Header value="Your words" size="4"/>

        <!-- TYPOLOGY_OPEN_ENDED_RESPONSES -->
        <Text name="q_user_accessibility_goal" value="What accessibility support were you trying to accomplish with AI?"/>
        <TextArea name="user_accessibility_goal" required="true" toName="dialogue" perRegion="true" rows="3" maxSubmissions="1"/>

        <Text name="q_user_why" value="Why were you seeking this support? (e.g., to navigate communication norms, expectations, accessibility barriers)"/>
        <TextArea name="user_why" required="true" toName="dialogue" perRegion="true" rows="3" maxSubmissions="1"/>

        <Text name="q_user_how_strategy" value="What were you trying to adjust?"/>
        <Choices name="user_how_strategy" required="true" toName="dialogue" perRegion="true" choice="multiple">
          <Choice value="My language"/>
          <Choice value="My tone"/>
          <Choice value="My self-expression"/>
          <Choice value="I was managing my self-disclosure"/>
          <Choice value="It was not my goal to adjust my communication style"/>
          <Choice value="It was not my goal to adjust my self-expression"/>
          <Choice value="Other"/>
        </Choices>
        <TextArea name="user_how_strategy_other" toName="dialogue" perRegion="true" rows="1" maxSubmissions="1"
                  placeholder="If Other, please describe."/>

        <Text name="q_user_wanted_ai" value="What were you hoping the AI would do in this moment?"/>
        <TextArea name="user_wanted_ai" required="true" toName="dialogue" perRegion="true" rows="3" maxSubmissions="1"/>

        <Text name="q_user_adjustment_matter" value="Why did this adjustment matter to you?"/>
        <TextArea name="user_adjustment_matter" required="true" toName="dialogue" perRegion="true" rows="3" maxSubmissions="1"/>

        <Text name="q_user_where" value="In what communication context was this?"/>
        <Choices name="user_where" required="true" toName="dialogue" perRegion="true" choice="multiple">
          <Choice value="Professional"/>
          <Choice value="Educational"/>
          <Choice value="Social/friendship"/>
          <Choice value="Romantic"/>
          <Choice value="Familial"/>
          <Choice value="Other"/>
          <Choice value="Not sure"/>
        </Choices>
        <TextArea name="user_where_other" toName="dialogue" perRegion="true" rows="1" maxSubmissions="1"
                  placeholder="If Other, please describe."/>

        <Text name="q_user_instance_description" value="In this instance, which best describes what happened?"/>
        <Choices name="user_instance_description" required="true" toName="dialogue" perRegion="true" choice="multiple">
          <Choice value="I adjusted myself so the AI could work better or understand me better"/>
          <Choice value="I used AI to help me adjust how I communicate, behave, or present myself to someone else"/>
          <Choice value="The AI automatically adjusted how I communicate, behave, or present myself"/>
          <Choice value="Not sure"/>
        </Choices>

        <Text name="q_user_benefits_challenges" value="Please describe any additional benefits or challenges you experienced during this interaction. This may include how this interaction made you feel."/>
        <TextArea name="user_benefits_challenges" required="true" toName="dialogue" perRegion="true" rows="3" maxSubmissions="1"/>

        <Text name="q_user_additional_explanation" value="Is there anything else you would like to explain about this interaction?"/>
        <TextArea name="user_additional_explanation" required="true" toName="dialogue" perRegion="true" rows="3" maxSubmissions="1"/>
      </View>

      <!-- TYPOLOGY_AI_ANNOTATIONS
           Observable behavior (ai_behavior) is stored separately from interpretation (ai_role). -->
      <View visibleWhen="region-selected" whenLabelValue="AI's text" className="typ-panel typ-ai">
        <Header value="AI's text" size="4"/>

        <Text name="q_ai_behavior" value="What did AI do in this highlighted passage?"/>
        <Choices name="ai_behavior" required="true" toName="dialogue" perRegion="true" choice="multiple">
          <Choice value="Preserved my language or expression"/>
          <Choice value="Modified my language or expression"/>
          <Choice value="Suggested changes to my communication but did not modify it"/>
          <Choice value="Suggested changes to my communication that were helpful"/>
          <Choice value="Suggested changes to my communication that were not helpful"/>
          <Choice value="Did not provide the support I requested"/>
          <Choice value="Changed or took out important meanings in my message"/>
          <Choice value="Ignored or misunderstood my preferences"/>
        </Choices>

        <Text name="q_ai_behavior_explanation" value="How did this compare with what you wanted?"/>
        <TextArea name="ai_behavior_explanation" required="true" toName="dialogue" perRegion="true" rows="3" maxSubmissions="1"/>

        <Text name="q_ai_benefits" value="What, if anything, did AI do particularly well in helping you communicate the way you wanted?"/>
        <Choices name="ai_benefits" required="true" toName="dialogue" perRegion="true" choice="multiple">
          <Choice value="Saved time"/>
          <Choice value="Saved energy"/>
          <Choice value="I think it decreased social risks (e.g., discrimination, prejudice)"/>
          <Choice value="Decrease emotional risks (e.g., anxiety, stress)"/>
          <Choice value="Helped preserve my intended expression"/>
          <Choice value="Helped me manage identity disclosure"/>
          <Choice value="I did not experience any benefits"/>
          <Choice value="Other"/>
        </Choices>
        <TextArea name="ai_benefits_other" toName="dialogue" perRegion="true" rows="1" maxSubmissions="1"
                  placeholder="If Other, please describe."/>

        <Text name="q_ai_challenges" value="What, if anything, did AI do particularly poorly in helping you communicate the way you wanted?"/>
        <Choices name="ai_challenges" required="true" toName="dialogue" perRegion="true" choice="multiple">
          <Choice value="Required more time for revisions"/>
          <Choice value="Required more effort for revisions"/>
          <Choice value="Misrepresented my identity"/>
          <Choice value="Changed my intended meaning"/>
          <Choice value="Reduced my control"/>
          <Choice value="I did not experience any challenges"/>
          <Choice value="Other"/>
        </Choices>
        <TextArea name="ai_challenges_other" toName="dialogue" perRegion="true" rows="1" maxSubmissions="1"
                  placeholder="If Other, please describe."/>

        <Text name="q_ai_outcome_explanation" value="How would you have liked the AI to support you differently in this interaction?"/>
        <TextArea name="ai_outcome_explanation" required="true" toName="dialogue" perRegion="true" rows="3" maxSubmissions="1"/>

        <Text name="q_ai_would_respond_differently" value="Would you have wanted AI to respond differently? If so, what should it have done, and why?"/>
        <TextArea name="ai_would_respond_differently" required="true" toName="dialogue" perRegion="true" rows="3" maxSubmissions="1"/>

        <Text name="q_ai_followup_adjustment" value="What did you do after this response, if anything?"/>
        <Choices name="ai_followup_adjustment" required="true" toName="dialogue" perRegion="true" choice="single-radio">
          <Choice value="I manually changed it"/>
          <Choice value="I did not change anything"/>
          <Choice value="I re-prompted the AI to change it"/>
        </Choices>
        <Text name="q_ai_followup_explanation" value="What prompted this action, and did it require extra effort?"/>
        <TextArea name="ai_followup_explanation" required="true" toName="dialogue" perRegion="true" rows="3" maxSubmissions="1"/>
      </View>

      <!-- Required controls apply to each created region. Other-description fields are optional. -->

      <!-- TYPOLOGY_CONVERSATION_CONTEXT: no perRegion, so each answer is saved once per conversation -->
      <View className="typ-panel typ-conv">
        <Header value="About this conversation" size="4"/>
        <Text name="q_conversation_accessibility_context" value="What accessibility support were you trying to accomplish with AI?"/>
        <TextArea name="conversation_accessibility_context" required="true" toName="dialogue" rows="3" maxSubmissions="1"/>
        <Text name="q_conversation_additional_context" value="Is there anything important about your communication preferences or experience that is not visible in the conversation?"/>
        <TextArea name="conversation_additional_context" required="true" toName="dialogue" rows="3" maxSubmissions="1"/>
      </View>

      <!-- TYPOLOGY_DATA_EXPORT
           passage_type results hold start/end (indexes into data.dialogue), startOffset/endOffset and text.
           Per-region answers share that region's id. Look up message_id and role via data.dialogue[start]. -->
    </View>
  </View>
</View>